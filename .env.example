PORT=3000
DATABASE_PATH=./data/platform.db
UPLOAD_DIR=./uploads
MUNICIPALITY_EMAIL=example@limbazunovads.lv
MAX_UPLOAD_MB=10
PDF_DIR=./data/pdfs
# Ceļš uz TTF/OTF fontu ar latviešu rakstzīmēm
PDF_FONT_PATH=C:/Windows/Fonts/arial.ttf
# Turpmākajām integrācijām; sensitīvās vērtības glabā tikai .env
SEARCH_PROVIDER=disabled
AI_PROVIDER=disabled
SIGNING_PROVIDER=mock
ENABLE_SIGNING_API=false
# Mock ir paredzēts tikai lokālai izstrādei; production vidē izmanto eparaksts_portal.
SIGNED_DOCUMENT_DIR=./data/signed
PUBLIC_BASE_URL=http://localhost:3000
REQUIRE_HTTPS=false
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PUBLIC=30
RATE_LIMIT_AUTHENTICATED=120
EPARAKSTS_PORTAL_BASE_URL=https://www.eparaksts.lv
EPARAKSTS_PORTAL_USERNAME=
EPARAKSTS_PORTAL_PASSWORD=
# Ja produkcijas integrācijai tiek izmantoti sertifikāti, norādi tikai servera failu ceļus.
EPARAKSTS_CLIENT_CERT_PATH=
EPARAKSTS_CLIENT_KEY_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_PROVIDER=mock
MAIL_FROM=
# Mock nosūtīšana ir aizliegta pēc noklusējuma, arī lokālā vidē.
ALLOW_MOCK_DELIVERY=false
MAX_DELIVERY_ATTEMPTS=3
# Neatstāj vērtību, ja atbildes termiņš nav apstiprināts. Juridisks termiņš kodā netiek pieņemts.
DEFAULT_RESPONSE_DUE_DAYS=
# Ienākošo pašvaldības e-pastu savienotājs izmanto šo servera noslēpumu webhook autentificēšanai.
INBOUND_WEBHOOK_SECRET=
# Administratora API darbībām (retry, termiņš) — tikai servera konfigurācijā.
ADMIN_API_TOKEN=
